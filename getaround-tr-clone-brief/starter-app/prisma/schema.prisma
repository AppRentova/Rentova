generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum UserRole { RENTER OWNER ADMIN }
enum VerificationStatus { PENDING APPROVED REJECTED EXPIRED }
enum VehicleStatus { DRAFT IN_REVIEW ACTIVE PAUSED REJECTED }
enum BookingStatus { PENDING CONFIRMED ACTIVE COMPLETED CANCELLED DISPUTED }
enum PaymentStatus { CREATED AUTHORIZED CAPTURED REFUNDED FAILED }

model User { id String @id @default(cuid()); email String @unique; role UserRole @default(RENTER); profile Profile?; verification Verification?; vehicles Vehicle[]; bookings Booking[]; reviews Review[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Profile { id String @id @default(cuid()); userId String @unique; user User @relation(fields:[userId],references:[id],onDelete:Cascade); firstName String; lastName String; phone String?; city String? }
model Verification { id String @id @default(cuid()); userId String @unique; user User @relation(fields:[userId],references:[id],onDelete:Cascade); status VerificationStatus @default(PENDING); provider String @default("mock"); externalReference String?; expiresAt DateTime?; updatedAt DateTime @updatedAt }
model Vehicle { id String @id @default(cuid()); ownerId String; owner User @relation(fields:[ownerId],references:[id]); make String; model String; year Int; plateEncrypted String; fuel String; transmission String; seats Int; mileage Int; city String; district String; approximateLatitude Float?; approximateLongitude Float?; status VehicleStatus @default(DRAFT); photos VehiclePhoto[]; availability VehicleAvailability[]; pricing VehiclePricing?; bookings Booking[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model VehiclePhoto { id String @id @default(cuid()); vehicleId String; vehicle Vehicle @relation(fields:[vehicleId],references:[id],onDelete:Cascade); url String; sortOrder Int @default(0); mimeType String }
model VehicleAvailability { id String @id @default(cuid()); vehicleId String; vehicle Vehicle @relation(fields:[vehicleId],references:[id],onDelete:Cascade); startsAt DateTime; endsAt DateTime; available Boolean @default(true); @@index([vehicleId,startsAt,endsAt]) }
model VehiclePricing { id String @id @default(cuid()); vehicleId String @unique; vehicle Vehicle @relation(fields:[vehicleId],references:[id],onDelete:Cascade); hourlyPrice Int; dailyPrice Int; currency String @default("TRY"); includedKilometers Int }
model Booking { id String @id @default(cuid()); renterId String; renter User @relation(fields:[renterId],references:[id]); vehicleId String; vehicle Vehicle @relation(fields:[vehicleId],references:[id]); startsAt DateTime; endsAt DateTime; status BookingStatus @default(PENDING); totalAmount Int; currency String @default("TRY"); idempotencyKey String @unique; payments Payment[]; inspections Inspection[]; damageReports DamageReport[]; review Review?; @@index([vehicleId,startsAt,endsAt]) }
model Payment { id String @id @default(cuid()); bookingId String; booking Booking @relation(fields:[bookingId],references:[id]); provider String @default("mock"); providerReference String? @unique; status PaymentStatus @default(CREATED); amount Int; currency String @default("TRY"); idempotencyKey String @unique; createdAt DateTime @default(now()) }
model Inspection { id String @id @default(cuid()); bookingId String; booking Booking @relation(fields:[bookingId],references:[id]); type String; mileage Int; fuelLevel Int; photos InspectionPhoto[]; createdAt DateTime @default(now()) }
model InspectionPhoto { id String @id @default(cuid()); inspectionId String; inspection Inspection @relation(fields:[inspectionId],references:[id],onDelete:Cascade); url String; mimeType String }
model DamageReport { id String @id @default(cuid()); bookingId String; booking Booking @relation(fields:[bookingId],references:[id]); description String; status String @default("OPEN"); createdAt DateTime @default(now()) }
model Review { id String @id @default(cuid()); bookingId String @unique; booking Booking @relation(fields:[bookingId],references:[id]); authorId String; author User @relation(fields:[authorId],references:[id]); rating Int; comment String; createdAt DateTime @default(now()) }
model Message { id String @id @default(cuid()); senderId String; recipientId String; bookingId String?; body String; createdAt DateTime @default(now()); @@index([bookingId,createdAt]) }
model SupportTicket { id String @id @default(cuid()); userId String; subject String; status String @default("OPEN"); priority String @default("NORMAL"); createdAt DateTime @default(now()) }
model AdminAuditLog { id String @id @default(cuid()); adminId String; action String; targetType String; targetId String; metadata Json?; createdAt DateTime @default(now()); @@index([targetType,targetId]) }
model PromoCode { id String @id @default(cuid()); code String @unique; discountType String; discountValue Int; active Boolean @default(true); expiresAt DateTime? }
model Referral { id String @id @default(cuid()); referrerId String; referredUserId String @unique; code String; status String @default("PENDING"); createdAt DateTime @default(now()) }
